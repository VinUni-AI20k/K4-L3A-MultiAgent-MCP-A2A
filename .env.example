COMPETITION_API_URL=https://n7-competition.pages.dev
COMPETITION_TEAM_API_KEY=sk-team-replace_me
MCP_ENDPOINT=https://day09-competition.34-142-201-239.sslip.io/mcp

# LLM verifier: openrouter (default) or ollama
LLM_PROVIDER=openrouter
# OpenRouter: https://openrouter.ai/api/v1
# Ollama:     http://localhost:11434/v1
LLM_BASE_URL= https://openrouter.ai/api/v1
# Set to your OpenRouter key. Ollama accepts a non-secret dummy value such as "ollama".
# You may leave this blank and export OPENROUTER_API_KEY instead.
LLM_API_KEY=
# Recommended JSON/reasoning models under 10B:
# qwen/qwen-2.5-7b-instruct or meta-llama/llama-3.1-8b-instruct
# For Ollama, normally use qwen2.5:7b-instruct or llama3.1:8b-instruct.
LLM_MODEL=qwen/qwen-2.5-7b-instruct
LLM_TIMEOUT=12.0
